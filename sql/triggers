CREATE TRIGGER TR_Grade_CheckMaxValue
ON Grade
AFTER INSERT, UPDATE
AS
BEGIN
    IF EXISTS (
        SELECT 1
        FROM inserted
        WHERE Value > MaxValue
    )
    BEGIN
        THROW 50001,
            N'Помилка: оцінка не може перевищувати максимальний бал!',
            1;
    END;
END;
GO
