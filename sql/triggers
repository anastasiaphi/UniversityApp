 
CREATE OR ALTER TRIGGER dbo.trg_Student_Audit
ON Student
AFTER UPDATE
AS
BEGIN
    SET NOCOUNT ON;
 
    UPDATE s
    SET ModifiedAt = SYSDATETIME()
    FROM Student s
        INNER JOIN inserted i ON i.ID = s.ID;
END;
GO
 
