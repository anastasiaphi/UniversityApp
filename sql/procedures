CREATE OR ALTER PROCEDURE dbo.sp_RestoreDiscipline
    @DisciplineID      INT,
    @ModifiedByUserID  INT = NULL
AS
BEGIN
    SET NOCOUNT ON;
 
    IF NOT EXISTS (SELECT 1 FROM Discipline WHERE ID = @DisciplineID AND IsDeleted = 1)
        THROW 50044, N'Дисципліну не знайдено або вона не видалена.', 1;
 
    UPDATE Discipline
    SET IsDeleted = 0,
        ModifiedByUserID = @ModifiedByUserID
    WHERE ID = @DisciplineID;
END;
GO
 

 
CREATE OR ALTER PROCEDURE dbo.sp_AddGroup
    @SpecializationID  INT,
    @Name              NVARCHAR(20),
    @StartYear         SMALLINT,
    @EndYear           SMALLINT = NULL,
    @NewGroupID        INT OUTPUT
AS
BEGIN
    SET NOCOUNT ON;
 
    IF NOT EXISTS (SELECT 1 FROM Specialization WHERE ID = @SpecializationID)
        THROW 50024, N'Спеціальність не знайдено.', 1;
 
    IF EXISTS (SELECT 1 FROM SGroup WHERE Name = @Name)
        THROW 50025, N'Група з такою назвою вже існує.', 1;
 
    IF @EndYear IS NOT NULL AND @EndYear <= @StartYear
        THROW 50026, N'Рік випуску має бути більшим за рік вступу.', 1;
 
    INSERT INTO SGroup (SpecializationID, Name, StartYear, EndYear)
    VALUES (@SpecializationID, @Name, @StartYear, @EndYear);
 
    SET @NewGroupID = SCOPE_IDENTITY();
END;
GO
