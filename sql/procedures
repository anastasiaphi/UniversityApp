--- створити студента
CREATE OR ALTER PROCEDURE dbo.sp_AddStudent
    @GroupID       INT,
    @FirstName     NVARCHAR(50),
    @LastName      NVARCHAR(50),
    @MiddleName    NVARCHAR(50) = NULL,
    @BirthDate     DATE         = NULL,
    @Phone         NVARCHAR(20) = NULL,
    @UniUserID     INT          = NULL,
    @NewStudentID  INT OUTPUT
AS
BEGIN
    SET NOCOUNT ON;
 
    IF NOT EXISTS (SELECT 1 FROM SGroup WHERE ID = @GroupID AND IsDeleted = 0)
        THROW 50001, N'Групу не знайдено або вона в архіві.', 1;
 
    INSERT INTO Student (UniUserID, GroupID, FirstName, MiddleName, LastName, BirthDate, Phone)
    VALUES (@UniUserID, @GroupID, @FirstName, @MiddleName, @LastName, @BirthDate, @Phone);
 
    SET @NewStudentID = SCOPE_IDENTITY();
END;
GO
 
-- "Видалити" студента 
CREATE OR ALTER PROCEDURE dbo.sp_SoftDeleteStudent
    @StudentID         INT,
    @ModifiedByUserID  INT = NULL
AS
BEGIN
    SET NOCOUNT ON;
 
    IF NOT EXISTS (SELECT 1 FROM Student WHERE ID = @StudentID AND IsDeleted = 0)
        THROW 50002, N'Студента не знайдено або його вже видалено.', 1;
 
    UPDATE Student
    SET IsDeleted = 1,
        ModifiedByUserID = @ModifiedByUserID
    WHERE ID = @StudentID;
END;
GO

CREATE OR ALTER PROCEDURE dbo.sp_AddTeacher
    @DepartmentID  INT,
    @PositionID    INT,
    @FirstName     NVARCHAR(50),
    @LastName      NVARCHAR(50),
    @MiddleName    NVARCHAR(50) = NULL,
    @UniUserID     INT          = NULL,
    @NewTeacherID  INT OUTPUT
AS
BEGIN
    SET NOCOUNT ON;
 
    IF NOT EXISTS (SELECT 1 FROM Department WHERE ID = @DepartmentID)
        THROW 50020, N'Кафедру не знайдено.', 1;
 
    IF NOT EXISTS (SELECT 1 FROM [Position] WHERE ID = @PositionID)
        THROW 50020, N'Посаду не знайдено.', 1;
 
    IF @UniUserID IS NOT NULL
       AND NOT EXISTS (SELECT 1 FROM UniUser WHERE ID = @UniUserID AND IsDeleted = 0)
        THROW 50038, N'Користувача не знайдено або його видалено.', 1;
 
    INSERT INTO Teacher (UniUserID, DepartmentID, PositionID, FirstName, MiddleName, LastName)
    VALUES (@UniUserID, @DepartmentID, @PositionID, @FirstName, @MiddleName, @LastName);
 
    SET @NewTeacherID = SCOPE_IDENTITY();
END;
GO
 
